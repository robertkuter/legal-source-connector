{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/legal-source-connector/review-case-report.v1.schema.json",
  "title": "Privacy-safe Swedish SFS review case report",
  "description": "A strict, user-reviewed issue draft for a locator whose retrieval was withheld. It intentionally excludes source excerpts, matter context, reviewer data, hashes and local paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "report_kind",
    "case_id",
    "occurrence_id",
    "created_at",
    "workflow_status",
    "source",
    "locator",
    "blocker",
    "implementation",
    "reproduction",
    "github",
    "privacy"
  ],
  "properties": {
    "schema_id": { "const": "sv_sfs_review_case_report" },
    "schema_version": { "const": "1.0.0" },
    "report_kind": { "enum": ["unsupported_source_pattern", "capability_need"] },
    "case_id": { "type": "string", "pattern": "^lscase-[0-9a-f]{20}$" },
    "occurrence_id": { "type": "string", "pattern": "^lsocc-[0-9a-f]{20}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "workflow_status": { "const": "retrieval_withheld" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "authority_id", "sfs_number", "title", "snapshot_at", "official_text_url", "official_html_url"],
      "properties": {
        "provider_id": { "type": "string", "minLength": 1 },
        "authority_id": { "type": "string", "minLength": 1 },
        "sfs_number": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "snapshot_at": { "type": ["string", "null"], "format": "date-time" },
        "official_text_url": { "type": ["string", "null"], "format": "uri" },
        "official_html_url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "canonical"],
      "properties": {
        "requested": { "type": "string", "minLength": 1 },
        "canonical": { "type": "string", "minLength": 1 }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reason_codes", "signal_kinds", "automatic_capability_status", "publisher_anchor_count", "text_candidate_count"],
      "properties": {
        "disposition": { "enum": ["explanation_only", "unsupported_pattern"] },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "signal_kinds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "automatic_capability_status": { "type": "string", "minLength": 1 },
        "publisher_anchor_count": { "type": "integer", "minimum": 0 },
        "text_candidate_count": { "type": "integer", "minimum": 0 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_review_version", "index_version", "artifact_schema_version", "decision_schema_version", "review_signal_vocabulary_version"],
      "properties": {
        "connector_review_version": { "type": "string", "minLength": 1 },
        "index_version": { "type": "string", "minLength": 1 },
        "artifact_schema_version": { "type": "string", "minLength": 1 },
        "decision_schema_version": { "type": "string", "minLength": 1 },
        "review_signal_vocabulary_version": { "type": "string", "minLength": 1 }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": { "command": { "type": "string", "minLength": 1 } }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new_issue_url"],
      "properties": { "new_issue_url": { "const": "https://github.com/robertkuter/legal-source-connector/issues/new" } }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_for_public_issue_draft", "requires_human_review_before_submission", "excluded_fields"],
      "properties": {
        "safe_for_public_issue_draft": { "const": true },
        "requires_human_review_before_submission": { "const": true },
        "excluded_fields": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
